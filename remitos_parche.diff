+        <span class="izj-txt"><b>${escHtml(i.descripcion)}</b><small>${escHtml(detalle)}</small></span>
+        <span class="chip tipo">${fmtN(i.saldo)} ${escHtml(i.unidad)} disp.</span>
+        <input type="number" min="0" max="${i.saldo}" step="any" value="${v ? v : ""}" placeholder="0" data-stk="${escHtml(i.codigo)}" style="width:92px;flex:none" title="Cantidad a enviar en ${escHtml(i.unidad)}">
+        <span style="font-size:12px;color:var(--texto-tenue);width:26px">${escHtml(i.unidad)}</span>
+      </div>`;
+    }).join("");
+  }
