+    }).sort((a, b) => String(a.descripcion).localeCompare(String(b.descripcion), "es", { numeric: true }));
+  }
+  function stkTotal_(){ return Object.keys(state.stkSel).filter(k => state.stkSel[k] > 0).length; }
