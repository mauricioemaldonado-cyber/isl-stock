+  // ===== STOCK (cables y materiales de almacén): selección múltiple con saldo del origen =====
+  function stkFiltrados_(){
+    const tokens = normalizarBusqueda_(state.stkBuscar).split(/\s+/).filter(Boolean);
+    return state.stkDisponibles.filter(i => {
+      if (state.stkCategoria && i.categoria !== state.stkCategoria) return false;
+      const txt = normalizarBusqueda_([i.codigo, i.descripcion, i.categoria, i.subtipo].join(" "));
