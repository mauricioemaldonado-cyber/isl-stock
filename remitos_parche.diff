+      }));
+  }
+  async function cargarStock_(){
+    const origen = $("obraOrigen").value;
+    if (state.tipo !== "Stock") return;
+    state.stkDisponibles = []; state.stkDetalle = "";
+    if (!origen) { renderItems(); return; }
+    if (STOCK_URL.indexOf("PEGAR_") >= 0) { mostrarError("Falta configurar STOCK_URL en el archivo de la página."); return; }
+    state.cargandoStk = true; renderItems();
+    try {
+      const res = await fetch(`${STOCK_URL}?accion=stock_por_nodo&nodo=${encodeURIComponent(origen)}`);
+      const data = await res.json();
+      if ($("obraOrigen").value !== origen) return;
+      if (data.error) throw new Error(data.detalle || data.error);
+      state.stkDisponibles = data.items || [];
+      state.stkDetalle = data.detalle || "";
+      const cods = new Set(state.stkDisponibles.map(i => i.codigo));
+      Object.keys(state.stkSel).forEach(c => { if (!cods.has(c)) delete state.stkSel[c]; });
+    } catch (err) {
+      mostrarError("No se pudo cargar el stock de ese origen (" + err.message + ").");
+    } finally {
+      state.cargandoStk = false; renderItems();
+    }
+  }
