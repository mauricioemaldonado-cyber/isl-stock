+      box.innerHTML = `
+        <div class="izj-aviso">Escribí la cantidad a enviar de cada ítem (máximo: lo que hay en el origen). Los cables van en metros.</div>
+        <div class="izj-barra">
+          <input type="search" id="stkBuscar" placeholder="Buscar (ej: 4x16, comando, CAB-012…)" value="${escHtml(state.stkBuscar)}">
+          <select id="stkCat"><option value="">Todas las categorías</option>${cats.map(t => `<option value="${escHtml(t)}" ${t === state.stkCategoria ? "selected" : ""}>${escHtml(t)}</option>`).join("")}</select>
+        </div>
+        <div class="izj-acciones"><button type="button" id="stkLimpiar">Limpiar</button><span id="stkCuenta">${stkTotal_()} ítem(s) a enviar</span></div>
+        <div class="izj-lista" id="stkLista">${stkFilasHtml_()}</div>`;
+    }
+    cont.appendChild(box);
+    if (!box.querySelector("#stkLista")) return;
+    const refrescar = () => { $("stkLista").innerHTML = stkFilasHtml_(); $("stkCuenta").textContent = stkTotal_() + " ítem(s) a enviar"; };
+    $("stkBuscar").addEventListener("input", e => { state.stkBuscar = e.target.value; refrescar(); });
+    $("stkCat").addEventListener("change", e => { state.stkCategoria = e.target.value; refrescar(); });
+    $("stkLimpiar").addEventListener("click", () => { state.stkSel = {}; refrescar(); });
+    $("stkLista").addEventListener("input", e => {
+      const cod = e.target.dataset && e.target.dataset.stk;
+      if (cod == null) return;
+      const it = state.stkDisponibles.find(x => x.codigo === cod); if (!it) return;
+      let q = parseFloat(String(e.target.value).replace(",", "."));
+      if (isNaN(q) || q <= 0) { delete state.stkSel[cod]; }
+      else {
+        if (q > it.saldo) { q = it.saldo; e.target.value = q; }
+        state.stkSel[cod] = q;
+      }
+      $("stkCuenta").textContent = stkTotal_() + " ítem(s) a enviar";
+    });
+  }
+  function itemsStock_(){
+    // Se envía como tipo "Material" (lo procesa el servidor de remitos tal cual) y se marca extra.stock
+    // para que el backend de Stock lo registre como movimiento.
+    return state.stkDisponibles.filter(i => state.stkSel[i.codigo] > 0)
