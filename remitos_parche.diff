+    const lista = stkFiltrados_();
+    if (!lista.length) return `<div class="mat-vacio">Ningún ítem coincide.</div>`;
+    const fmtN = (n) => Number(n).toLocaleString("es-AR", { maximumFractionDigits: 3 });
+    return lista.map(i => {
